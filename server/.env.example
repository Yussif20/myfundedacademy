# --- Core ---
NODE_ENV=development
PROJECT_NAME=My Funded Academy
PORT=5000

# --- URLs ---
BASE_URL_SERVER_DEV=http://localhost:5000
BASE_URL_SERVER=https://api.myfundedacademy.com
BASE_URL_CLIENT=http://localhost:3000
COOKIE_DOMAIN=

# --- Database ---
DATABASE_URL=postgresql://user:pass@host:5432/mfa?sslmode=require

# --- Redis (Upstash) ---
REDIS_URL=rediss://default:password@host:6379

# --- Auth ---
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=change-me-in-prod
JWT_REFRESH_SECRET=change-me-in-prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INVITE_TOKEN_SECRET=change-me-in-prod

# --- Super-admin seed ---
ADMIN_EMAIL=admin@myfundedacademy.com
ADMIN_PASSWORD=change-me-in-prod

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx
EMAIL_FROM=no-reply@myfundedacademy.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_CLIENT_ID=ca_test_xxx
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# --- VdoCipher ---
VDOCIPHER_API_SECRET=

# --- DigitalOcean Spaces ---
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=mfa-prod
DO_SPACES_REGION=fra1
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
