# --- Core ---
NODE_ENV=development
PROJECT_NAME=My Funded Academy
PORT=5000

# --- URLs ---
BASE_URL_SERVER_DEV=http://localhost:5000
BASE_URL_SERVER=https://api.myfundedacademy.com
BASE_URL_CLIENT=http://localhost:3000
COOKIE_DOMAIN=

# --- Database ---
DATABASE_URL=postgresql://user:pass@host:5432/mfa?sslmode=require

# --- Redis (skipped for MVP — leave blank) ---
REDIS_URL=

# --- Auth ---
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=change-me-in-prod
JWT_REFRESH_SECRET=change-me-in-prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INVITE_TOKEN_SECRET=change-me-in-prod

# --- Super-admin seed ---
ADMIN_EMAIL=admin@myfundedacademy.com
ADMIN_PASSWORD=change-me-in-prod

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx
EMAIL_FROM=no-reply@myfundedacademy.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_CLIENT_ID=ca_test_xxx
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# --- VdoCipher ---
VDOCIPHER_API_SECRET=

# --- Object storage (S3-compatible — Cloudflare R2 for MVP, DO Spaces or AWS post-signoff) ---
# For Cloudflare R2: endpoint = https://<account-id>.r2.cloudflarestorage.com, region = auto
# For DO Spaces:    endpoint = https://<region>.digitaloceanspaces.com,    region = e.g. fra1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mfa-mvp
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_URL=

