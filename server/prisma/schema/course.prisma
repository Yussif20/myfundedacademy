model Course {
  id String @id @default(uuid())

  slug              String @unique
  title             String
  titleArabic       String @default("")
  shortDescription  String @default("")
  shortDescriptionArabic String @default("")
  description       String @default("")
  descriptionArabic String @default("")

  thumbnail        String  @default("")
  promoVideoVdoId  String  @default("")

  level    CourseLevel    @default(ALL_LEVELS)
  language CourseLanguage @default(EN)
  status   CourseStatus   @default(DRAFT)

  oneTimePrice Float      @default(0)
  accessTier   AccessTier @default(FREE)

  totalDurationMin Int @default(0)
  totalLessons     Int @default(0)

  isFeatured  Boolean @default(false)
  publishedAt DateTime?

  categoryId   String?
  instructorId String

  category   Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  instructor InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  sections   Section[]

  enrollments  Enrollment[]
  orders       Order[]
  quiz         Quiz?
  certificates Certificate[]
  reviews      Review[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, isFeatured])
  @@index([instructorId])
  @@index([categoryId])
  @@map("courses")
}

model Section {
  id          String  @id @default(uuid())
  courseId    String
  title       String
  titleArabic String  @default("")
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, order])
  @@map("sections")
}

model Lesson {
  id          String  @id @default(uuid())
  sectionId   String
  title       String
  titleArabic String  @default("")
  description String  @default("")
  descriptionArabic String @default("")
  order       Int     @default(0)

  vdoVideoId    String @default("")
  durationMin   Int    @default(0)
  isFreePreview Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section     Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  attachments LessonAttachment[]
  progress    Progress[]

  @@index([sectionId, order])
  @@map("lessons")
}

model LessonAttachment {
  id        String @id @default(uuid())
  lessonId  String
  fileName  String
  fileKey   String
  fileSize  Int    @default(0)
  fileType  String @default("")

  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_attachments")
}
